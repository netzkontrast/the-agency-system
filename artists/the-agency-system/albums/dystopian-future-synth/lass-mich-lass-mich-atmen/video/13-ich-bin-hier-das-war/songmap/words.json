   "t": 56.5,
   "end": 58.74,
   "key": {
    "w": "hier.",
    "t": 57.9,
    "stress": 58.152
   }
  },
  {
   "i": 9,
   "text": "Ich hab nach Luft gefragt. Ich hab es laut verlangt.",
   "section": "Verse 2",
   "t": 61.46,
   "end": 65.52,
   "key": {
    "w": "verlangt.",
    "t": 64.56,
    "stress": 64.848
   }
  },
  {
   "i": 10,
   "text": "Jetzt frag ich nicht mehr. Die Luft ist einfach da.",
