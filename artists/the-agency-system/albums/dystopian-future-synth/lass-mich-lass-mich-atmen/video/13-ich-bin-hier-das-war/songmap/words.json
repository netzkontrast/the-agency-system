 "lines": [
  {
   "i": 0,
   "text": "Der Puls ist langsam. Der Puls ist meiner.",
   "section": "Intro",
   "t": 1.68,
   "end": 8.02,
   "key": {
    "w": "meiner.",
    "t": 7.58,
    "stress": 7.712
   }
  },
  {
   "i": 1,
   "text": "Das Gelb hängt in den Vorhängen. Es ist nur Licht.",
   "section": "Verse 1",
   "t": 21.9,
   "end": 26.32,
   "key": {
    "w": "Licht.",
    "t": 25.78,
    "stress": 25.942
   }
  },
  {
   "i": 2,
   "text": "Kein Faden auf dem Mund. Kein Druck, der mich erstickt.",
   "section": "Verse 1",
   "t": 27.34,
   "end": 32.32,
   "key": {
    "w": "Druck,",
    "t": 30.04,
    "stress": 30.166
   }
  },
  {
   "i": 3,
   "text": "Ich atme ein. Ich atme aus. Niemand verhandelt mit.",
   "section": "Verse 1",
   "t": 32.32,
   "end": 37.34,
   "key": {
    "w": "aus.",
    "t": 34.76,
    "stress": 34.898
   }
  },
  {
   "i": 4,
   "text": "Der Raum ist still. Und ich bin hier.",
   "section": "Verse 1",
   "t": 38.4,
   "end": 44.64,
   "key": {
    "w": "hier.",
    "t": 43.92,
    "stress": 44.136
   }
  },
  {
   "i": 5,
   "text": "Ich bin hier.",
   "section": "Refrain",
   "t": 44.64,
   "end": 46.76,
   "key": {
    "w": "hier.",
    "t": 45.92,
    "stress": 46.172
   }
  },
  {
   "i": 6,
   "text": "Das war.",
   "section": "Refrain",
   "t": 46.94,
   "end": 48.58,
   "key": {
    "w": "war.",
    "t": 48.1,
    "stress": 48.244
   }
  },
  {
   "i": 7,
   "text": "Kein Sieg. Kein Ende. Nur das hier und das, was war.",
   "section": "Refrain",
   "t": 48.923,
   "end": 56.5,
   "key": {
    "w": "war.",
    "t": 55.86,
    "stress": 56.052
