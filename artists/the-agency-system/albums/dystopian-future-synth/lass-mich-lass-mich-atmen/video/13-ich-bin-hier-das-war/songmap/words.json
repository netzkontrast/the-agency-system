 "lines": [
  {
   "i": 0,
   "text": "Der Puls ist langsam. Der Puls ist meiner.",
   "section": "Intro",
   "t": 2.4,
   "end": 7.869,
   "key": {
    "w": "meiner.",
    "t": 7.067,
    "stress": 7.393
   }
  },
  {
   "i": 1,
   "text": "Das Gelb hängt in den Vorhängen. Es ist nur Licht.",
   "section": "Verse 1",
   "t": 12.4,
   "end": 17.906,
   "key": {
    "w": "Licht.",
    "t": 17.326,
    "stress": 17.562
   }
  },
  {
   "i": 2,
   "text": "Kein Faden auf dem Mund. Kein Druck, der mich erstickt.",
   "section": "Verse 1",
   "t": 20.4,
   "end": 25.872,
   "key": {
    "w": "Druck,",
    "t": 23.49,
    "stress": 23.709
   }
  },
  {
   "i": 3,
   "text": "Ich atme ein. Ich atme aus. Niemand verhandelt mit.",
   "section": "Verse 1",
   "t": 28.4,
   "end": 33.934,
   "key": {
    "w": "aus.",
    "t": 30.964,
    "stress": 31.129
   }
  },
  {
   "i": 4,
   "text": "Der Raum ist still. Und ich bin hier.",
   "section": "Verse 1",
   "t": 36.4,
   "end": 41.892,
   "key": {
    "w": "hier.",
    "t": 41.23,
    "stress": 41.5
   }
  },
  {
   "i": 5,
   "text": "Ich bin hier.",
   "section": "Refrain",
   "t": 44.4,
   "end": 47.051,
   "key": {
    "w": "hier.",
    "t": 46.138,
    "stress": 46.51
   }
  },
  {
   "i": 6,
   "text": "Das war.",
   "section": "Refrain",
   "t": 48.4,
   "end": 51.004,
   "key": {
    "w": "war.",
    "t": 49.8,
    "stress": 50.29
   }
  },
  {
   "i": 7,
   "text": "Kein Sieg. Kein Ende. Nur das hier und das, was war.",
   "section": "Refrain",
   "t": 52.4,
   "end": 57.935,
   "key": {
    "w": "war.",
    "t": 57.538,
    "stress": 57.699
   }
  },
  {
   "i": 8,
   "text": "Ich bin hier.",
   "section": "Refrain",
   "t": 60.4,
   "end": 63.051,
   "key": {
