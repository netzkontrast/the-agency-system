   "t": 65.52,
   "end": 70.2,
   "key": {
    "w": "da.",
    "t": 69.68,
    "stress": 69.836
   }
  },
  {
   "i": 11,
   "text": "Das, was war, bleibt wahr. Und es bleibt hinter mir.",
