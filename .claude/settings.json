{
  "extraKnownMarketplaces": {
    "bitwize-music": {
      "source": {
        "source": "github",
        "repo": "bitwize-music-studio/claude-ai-music-skills"
      }
    },
    "agency-marketplace": {
      "source": {
        "source": "github",
        "repo": "netzkontrast/the-agency-system"
      }
    },
    "superclaude": {
      "source": {
        "source": "github",
        "repo": "SuperClaude-Org/SuperClaude_Plugin"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "bitwize-music@bitwize-music": true,
    "agency-system@agency-marketplace": true,
    "sc@superclaude": true,
    "superpowers@superpowers-marketplace": true,
    "episodic-memory@superpowers-marketplace": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true
  },
  "enabledMcpjsonServers": [
    "agency-system",
    "context7",
    "sequential-thinking"
  ],
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "BashOutput",
      "KillBash",
      "Skill",
      "Tmux",
      "Monitor",
      "SendUserFile",
      "REPL",
      "ToolSearch",
      "Task",
      "Agent",
      "ExitPlanMode",
      "AskUserQuestion",
      "mcp__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/setup-bitwize-music.sh\""
          }
        ]
      }
    ]
  }
}
