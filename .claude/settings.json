{
  "extraKnownMarketplaces": {
    "bitwize-music": {
      "source": {
        "source": "github",
        "repo": "bitwize-music-studio/claude-ai-music-skills"
      }
    }
  },
  "enabledPlugins": {
    "bitwize-music@bitwize-music": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/setup-bitwize-music.sh"
          }
        ]
      }
    ]
  }
}
