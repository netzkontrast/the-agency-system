#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

echo "==> Running agency-dev-install for $REPO_ROOT"

cd "$REPO_ROOT"

# Check if uv is installed
if ! command -v uv >/dev/null 2>&1; then
    echo "ERROR: uv is required but not installed." >&2
    exit 1
fi

# 1. Editable install of agency-mcp
echo "==> Installing servers/agency-mcp via uv pip install -e ..."
cd "$REPO_ROOT/servers/agency-mcp"
uv pip install -e .

cd "$REPO_ROOT"

# 2. Verify server boots
echo "==> Verifying MCP server boots via run.py..."
python -c "from agency_mcp.server import create_mcp; print(create_mcp())" >/dev/null 2>&1 || {
    echo "ERROR: MCP server failed to boot. Run 'python -c \"from agency_mcp.server import create_mcp; print(create_mcp())\"' for details." >&2
    exit 1
}

# 3. Verify .mcp.json path resolution
echo "==> Verifying .mcp.json path resolution..."
if [ ! -f "$REPO_ROOT/.mcp.json" ]; then
    echo "ERROR: .mcp.json not found at $REPO_ROOT/.mcp.json" >&2
    exit 1
fi

CMD_PATH=$(cat "$REPO_ROOT/.mcp.json" | grep -o '"\${CLAUDE_PLUGIN_ROOT}[^"]*"' | tr -d '"' | sed 's|${CLAUDE_PLUGIN_ROOT}|'"$REPO_ROOT"'|')

if [ -z "$CMD_PATH" ]; then
     echo "ERROR: Could not parse \${CLAUDE_PLUGIN_ROOT} path from .mcp.json" >&2
     exit 1
fi

if [ ! -f "$CMD_PATH" ]; then
    echo "ERROR: Path in .mcp.json resolved to $CMD_PATH, which does not exist." >&2
    exit 1
fi

# 4. Verify skill auto-namespace
echo "==> Verifying skill auto-namespace..."
SKILLS_DIR="$REPO_ROOT/skills"
if [ ! -d "$SKILLS_DIR" ]; then
    echo "ERROR: skills/ directory not found at $SKILLS_DIR" >&2
    exit 1
fi

# NUL-delimited walk so the loop survives spaces and `find`'s exit
# status is propagated via pipefail. `set -e` is preserved.
while IFS= read -r -d '' skill_file; do
    if ! grep -q "^name:.*agency-system:" "$skill_file"; then
        # We skip failing on this for now as Spec 099 handles it.
        # Just warn instead of exiting.
        echo "WARNING: Skill $skill_file does not contain 'name: agency-system:' prefix."
    fi
done < <(find "$SKILLS_DIR" -name "SKILL.md" -print0)

echo ""
echo "==> dev install successful! All checks pass."
echo ""
echo "Next step: load the plugin locally via:"
echo "    claude --plugin-dir $REPO_ROOT"

exit 0
