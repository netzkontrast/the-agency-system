{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-system.dev/schemas/context/finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "claim",
    "confidence",
    "source_urls"
  ],
  "properties": {
    "topic": {
      "type": "string"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
