{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-system.dev/schemas/context/research-topic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "created_at"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "complete"
      ]
    }
  }
}
